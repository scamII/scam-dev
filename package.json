{
	"name": "scam-dev",
	"version": "1.0.0",
	"private": true,
	"description": "Private build tooling for the Scam Dev WordPress theme and plugins",
	"engines": {
		"node": ">=22 <23"
	},
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"lint:css": "wp-scripts lint-style",
		"lint:css:ci": "wp-scripts lint-style assets/scss/remediation.css \"plugins/**/assets/*.css\"",
		"lint:js": "wp-scripts lint-js assets/js/src assets/js/components plugins",
		"format": "wp-scripts format",
		"test:static": "node scripts/static-check.mjs",
		"test": "npm run test:static"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.1.0",
		"@wordpress/scripts": "^30.0.0",
		"autoprefixer": "^10.4.0",
		"postcss": "^8.5.0",
		"tailwindcss": "^4.1.0"
	},
	"dependencies": {
		"highlight.js": "^11.11.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	}
}
