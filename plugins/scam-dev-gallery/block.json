{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "scamdev/gallery",
	"title": "Галерея (Scam Dev)",
	"category": "media",
	"icon": "format-gallery",
	"description": "Галерея изображений с сеткой и доступным лайтбоксом.",
	"textdomain": "scam-dev-gallery",
	"attributes": {
		"cols": {
			"type": "number",
			"default": 3
		},
		"galleryId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"align": true
	},
	"editorScript": "file:./block.js",
	"render": "file:./render.php"
}
