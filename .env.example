# Docker image versions can be overridden explicitly.
MYSQL_IMAGE=mysql:8.0
WORDPRESS_IMAGE=wordpress:6.7-php8.3-apache
PHPMYADMIN_IMAGE=phpmyadmin:5.2-apache

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
WORDPRESS_DEBUG=0

# Matrix integration. Public registration remains disabled until explicitly
# enabled and protected with an invite code and/or Turnstile.
MATRIX_HOMESERVER_URL=https://matrix.example.com
MATRIX_EXPECTED_HOST=matrix.example.com
MATRIX_ADMIN_TOKEN=
MATRIX_CHAT_URL=https://chat.example.com
SCAM_DEV_MATRIX_REGISTRATION_ENABLED=0
SCAM_DEV_MATRIX_INVITE_CODE=
SCAM_DEV_TURNSTILE_SITE_KEY=
SCAM_DEV_TURNSTILE_SECRET_KEY=
SCAM_DEV_TURNSTILE_EXPECTED_HOST=example.com

# VK importer.
VK_API_TOKEN=

# Base64 Ed25519 public key used by the theme updater.
SCAM_DEV_UPDATE_PUBLIC_KEY=

# Explicit deployment configuration.
DEPLOY_HOST=example.com
DEPLOY_PORT=22
DEPLOY_USER=deploy
SITE_DOMAIN=example.com
WORDPRESS_ROOT=/var/www/html
REMOTE_RELEASE_ROOT=/var/www/releases/scam-dev
DEPLOY_OWNER=deploy
DEPLOY_GROUP=www-data
UPDATE_SIGNING_PRIVATE_KEY_FILE=/secure/path/scam-dev-ed25519-private.key
