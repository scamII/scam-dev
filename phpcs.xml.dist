<?xml version="1.0"?>
<ruleset name="Scam Dev">
	<description>WordPress and PHP compatibility checks for the theme and bundled plugins.</description>

	<file>functions.php</file>
	<file>inc</file>
	<file>template-parts</file>
	<file>plugins</file>
	<file>404.php</file>
	<file>archive.php</file>
	<file>comments.php</file>
	<file>footer.php</file>
	<file>front-page.php</file>
	<file>header.php</file>
	<file>index.php</file>
	<file>page-category-posts.php</file>
	<file>page.php</file>
	<file>search.php</file>
	<file>searchform.php</file>
	<file>sidebar.php</file>
	<file>single.php</file>

	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>
	<exclude-pattern>/.dev/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="warning-severity" value="0"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>

	<rule ref="PHPCompatibilityWP">
		<properties>
			<property name="testVersion" value="8.0-"/>
		</properties>
	</rule>

	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="120"/>
			<property name="absoluteLineLimit" value="160"/>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<severity>0</severity>
	</rule>

	<rule ref="Squiz.WhiteSpace.SuperfluousWhitespace.StartFile">
		<severity>0</severity>
	</rule>

	<rule ref="Squiz.Commenting.FileComment.SpacingAfterOpen">
		<severity>0</severity>
	</rule>
</ruleset>
